# Configuración pública. Copiar únicamente los valores reales que correspondan al despliegue.
NEXT_PUBLIC_SITE_URL=https://yago.cl

# Opcional: si está vacío, el diagnóstico utiliza el formulario con el servicio preseleccionado.
NEXT_PUBLIC_BOOKING_URL=

# Google Analytics 4: ID público del flujo web, con formato G-XXXXXXXXXX.
# Las visitas SPA se miden mediante historial del navegador en Medición mejorada.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Activar después de registrar el dominio en Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Opcionales: URL del script manual y endpoint si se utiliza una instalación personalizada.
NEXT_PUBLIC_PLAUSIBLE_SRC=
NEXT_PUBLIC_PLAUSIBLE_API=

# Opcionales para verificación por metaetiqueta. Search Console de dominio utiliza DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
